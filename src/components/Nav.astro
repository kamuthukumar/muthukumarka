---
const links = [
  ["news", "News"],
  ["research", "Research"],
  ["shinkai", "Shinkai-Labs"],
  ["journey", "Journey"],
  ["publications", "Publications"],
  ["teaching", "Teaching"],
  ["contact", "Contact"],
];
---
<header class="nav" id="nav">
  <div class="container nav-in">
    <a class="wordmark" href="#top" aria-label="Dr. K. A. Muthukumar, back to top">Dr. K. A. Muthukumar</a>
    <nav id="links" aria-label="Sections">
      {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>
    <div class="nav-end">
      <button type="button" class="icon-btn" id="theme" aria-label="Switch to dark theme">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="icon-btn" id="menu" aria-label="Menu" aria-expanded="false" aria-controls="links">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 300; transition: background-color var(--dur-short) var(--ease-out), box-shadow var(--dur-short) var(--ease-out); }
  .nav:global(.scrolled) { background: color-mix(in oklch, var(--paper) 92%, transparent); box-shadow: 0 1px 0 var(--rule); backdrop-filter: saturate(1.2) blur(8px); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); min-height: 68px; }
  .wordmark { font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
  nav { display: flex; gap: clamp(14px, 1.6vw, 26px); font-size: var(--text-sm); color: var(--muted); }
  nav a { text-decoration: none; padding-block: var(--space-xs); transition: color var(--dur-short) var(--ease-out); }
  nav a:global(.current) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }
  .nav-end { display: flex; gap: var(--space-xs); }
  .icon-btn { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--rule); border-radius: var(--radius); color: var(--ink-2); transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
  .sun { display: none; }
  :global(:root[data-theme="dark"]) .sun { display: block; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
  #menu { display: none; }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--ink); }
    .icon-btn:hover { border-color: var(--ink); color: var(--ink); }
  }
  @media (max-width: 64rem) {
    nav { display: none; }
    #menu { display: grid; }
    nav:global(.open) { display: flex; position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; gap: 0; padding: var(--space-xs) var(--gutter) var(--space-lg); background: var(--paper); box-shadow: 0 1px 0 var(--rule); font-size: var(--text-md); color: var(--ink-2); }
    nav:global(.open) a { padding-block: var(--space-sm); border-bottom: 1px solid var(--rule); }
  }
</style>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById("theme")!;
  const label = () => themeBtn.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
  label();
  themeBtn.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
    try { localStorage.setItem("theme", root.dataset.theme); } catch {}
    label();
    window.dispatchEvent(new Event("themechange"));
  });

  const nav = document.getElementById("nav")!, links = document.getElementById("links")!, menu = document.getElementById("menu")!;
  addEventListener("scroll", () => nav.classList.toggle("scrolled", scrollY > 8), { passive: true });
  const setMenu = (open: boolean) => { links.classList.toggle("open", open); menu.setAttribute("aria-expanded", String(open)); };
  menu.addEventListener("click", () => setMenu(!links.classList.contains("open")));
  links.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  addEventListener("keydown", (e) => { if (e.key === "Escape" && links.classList.contains("open")) { setMenu(false); menu.focus(); } });

  // mark the section in view
  const anchors = [...links.querySelectorAll<HTMLAnchorElement>("a")];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    anchors.forEach((a) => a.classList.toggle("current", a.hash === `#${e.target.id}`));
  }), { rootMargin: "-45% 0px -50% 0px" });
  anchors.forEach((a) => { const s = document.querySelector(a.hash); if (s) io.observe(s); });
  // at the top nothing is current
  const hero = document.getElementById("top");
  if (hero) new IntersectionObserver((es) => { if (es[0].isIntersecting) anchors.forEach((x) => x.classList.remove("current")); }, { threshold: 0.35 }).observe(hero);
</script>
