---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait-studio.jpg";
import site from "../../content/site.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="hero" id="top" aria-labelledby="hero-h">
  <div class="container hero-grid">
    <div class="copy">
      <h1 id="hero-h">{site.headline}</h1>
      <p class="lead">{site.role}</p>
      <div class="actions">
        <a class="btn primary" href="#publications">Read the publications</a>
        <a class="btn" href="#shinkai">Shinkai Labs</a>
        <a class="link" href={`${base}/${site.links.cv}`} target="_blank" rel="noopener">Download CV <span class="mono">(PDF)</span></a>
      </div>
    </div>
    <figure class="portrait">
      <div class="frame">
        <Picture src={portrait} formats={["avif", "webp"]} widths={[360, 480, 640, 880, 1254]} sizes="(max-width: 64rem) 62vw, 440px"
          alt="Portrait of Dr. K. A. Muthukumar" loading="eager" fetchpriority="high" class="photo" />
      </div>
      <figcaption class="credit mono"><span class="jp" lang="ja">慶應</span><span>Dr. K. A. Muthukumar, Keio 2022</span></figcaption>
    </figure>
  </div>

  <div class="strip" id="strip">
    <canvas id="trace" role="img" aria-label="Illustration: a noisy abdominal ECG recording is transported, point by point, into a clean fetal heartbeat."></canvas>
    <div class="container strip-labels" aria-hidden="true">
      <span class="mono in">abdominal ECG, raw</span>
      <span class="mono out">fetal ECG, recovered</span>
    </div>
  </div>
  <div class="container">
    <p class="caption mono"><span class="accent">Noise to Intelligence.</span> A synthetic recording, moved by monotone optimal transport: every point keeps its mass and no path crosses another. Scroll to run it back.</p>
  </div>
</section>

<style>
  .hero > :global(.container) { width: 100%; }
  .hero { position: relative; min-height: min(calc(100svh - 68px), 880px); display: grid; grid-template-rows: 1fr auto auto; padding-top: clamp(16px, 3vh, 48px); }
  .hero-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: center; }
  .copy { grid-column: 1 / span 7; padding-block: var(--space-lg) clamp(40px, 7vh, 96px); }
  h1 { font-size: var(--text-hero); line-height: 0.98; letter-spacing: -0.032em; font-variation-settings: "opsz" 72; max-width: 12.5ch; }
  .lead { margin-top: clamp(18px, 3vh, 32px); }
  .actions { margin-top: clamp(24px, 4vh, 40px); display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-md); align-items: center; }
  .actions .link { margin-left: var(--space-xs); }

  /* the portrait: a toned black-and-white print standing on the strip, credit set along its edge */
  .portrait { grid-column: 8 / span 5; justify-self: end; align-self: end; position: relative; z-index: 2; width: min(100%, 440px); margin-bottom: -1px; }
  .frame { position: relative; overflow: hidden; aspect-ratio: 4 / 5; }
  .portrait :global(.photo) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .frame { box-shadow: 0 30px 60px -34px oklch(20% 0.02 50 / 0.45); }
  .credit { position: absolute; left: -26px; top: 0; writing-mode: vertical-rl; text-orientation: mixed; display: flex; gap: var(--space-md); align-items: center; font-size: 0.72rem; color: var(--muted); white-space: nowrap; }
  .credit .jp { font-family: var(--font-display); font-size: 0.85rem; letter-spacing: 0.1em; color: var(--ink-2); }

  /* the strip: chart paper in light, a monitor field in dark */
  .strip { position: relative; height: clamp(150px, 22vh, 230px); border-block: 1px solid var(--rule);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px), linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid-minor) 1px, transparent 1px), linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 40px 40px, 40px 40px, 8px 8px, 8px 8px; background-position: -1px -1px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .strip-labels { position: absolute; inset: 0; display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: var(--space-sm); pointer-events: none; }
  .strip-labels span { color: var(--muted); background: var(--paper); padding: 2px 6px; transition: color var(--dur-long) var(--ease-out), opacity var(--dur-long) var(--ease-out); }
  .strip-labels .out { opacity: 0.55; }
  .strip[data-state="clean"] .strip-labels .in { opacity: 0.55; }
  .strip[data-state="clean"] .strip-labels .out { opacity: 1; color: var(--accent); }
  .caption { margin-block: var(--space-md) var(--space-xl); color: var(--muted); max-width: 72ch; }

  @media (max-width: 64rem) {
    .hero { min-height: 0; }
    .hero-grid { align-items: start; }
    .copy { grid-column: 1 / -1; order: 2; padding-block: var(--space-lg) var(--space-md); }
    .credit { font-size: 0.62rem; gap: var(--space-xs); }
    .portrait { grid-column: 1 / -1; order: 1; justify-self: start; width: min(62vw, 280px); margin-left: 22px; align-self: start; margin-bottom: 0; }
    .strip { margin-top: var(--space-xl); height: 170px; }
  }

  /* one authored entrance: the copy settles while the portrait rises out of the strip and develops */
  @keyframes settle { from { opacity: 0; transform: translateY(10px); } }
  @keyframes rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes develop { from { filter: brightness(1.25) saturate(0.4) blur(5px); transform: scale(1.04); } }
  @keyframes fadein { from { opacity: 0; } }
  .copy > * { animation: settle 620ms var(--ease-out) both; }
  .copy > :nth-child(2) { animation-delay: 70ms; }
  .copy > :nth-child(3) { animation-delay: 140ms; }
  .frame { animation: rise 1100ms cubic-bezier(0.32, 0.72, 0, 1) 120ms both; }
  .portrait :global(.photo) { animation: develop 1700ms cubic-bezier(0.33, 0.1, 0.25, 1) 200ms both; }
  .credit { animation: fadein 600ms var(--ease-out) 1000ms both; }
</style>

<script>
  import { mountTrace } from "../scripts/trace";
  mountTrace(document.getElementById("trace") as HTMLCanvasElement, document.querySelector(".hero") as HTMLElement);
</script>
