---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import site from "../../content/site.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="hero" id="top" aria-labelledby="hero-h">
  <div class="container hero-grid">
    <div class="copy">
      <h1 id="hero-h">{site.headline}</h1>
      <p class="lead">{site.role}</p>
      <div class="actions">
        <a class="btn primary" href="#publications">Read the publications</a>
        <a class="btn" href="#shinkai">Shinkai Labs</a>
        <a class="link" href={`${base}/${site.links.cv}`} target="_blank" rel="noopener">Download CV <span class="mono">(PDF)</span></a>
      </div>
    </div>
    <figure class="print">
      <div class="mat">
        <div class="window">
          <Picture src={portrait} formats={["avif", "webp"]} widths={[360, 480, 640, 840, 1000]} sizes="(max-width: 64rem) 60vw, 460px"
            alt="Portrait of K. A. Muthukumar" loading="eager" fetchpriority="high" class="photo" />
          <span class="light" aria-hidden="true"></span>
        </div>
        <figcaption class="edition"><span class="hand" aria-hidden="true"></span><span class="who">K. A. Muthukumar, Ph.D. Keio, 2022</span><span class="jp" lang="ja">慶應</span></figcaption>
      </div>
    </figure>
  </div>

  <div class="strip" id="strip">
    <canvas id="trace" role="img" aria-label="Illustration: a noisy abdominal ECG recording is transported, point by point, into a clean fetal heartbeat."></canvas>
    <div class="container strip-labels" aria-hidden="true">
      <span class="mono in">abdominal ECG, raw</span>
      <span class="mono out">fetal ECG, recovered</span>
    </div>
  </div>
  <div class="container">
    <p class="caption mono">Noise to information. A synthetic recording, moved by monotone optimal transport: every point keeps its mass and no path crosses another. Scroll to run it back.</p>
  </div>
</section>

<style>
  .hero > :global(.container) { width: 100%; }
  .hero { position: relative; min-height: calc(100svh - 68px); display: grid; grid-template-rows: 1fr auto auto; padding-top: clamp(16px, 3vh, 48px); }
  .hero-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: center; }
  .copy { grid-column: 1 / span 7; padding-block: var(--space-lg) clamp(40px, 7vh, 96px); }
  h1 { font-size: var(--text-hero); line-height: 0.98; letter-spacing: -0.032em; font-variation-settings: "opsz" 72; max-width: 12.5ch; }
  .lead { margin-top: clamp(18px, 3vh, 32px); }
  .actions { margin-top: clamp(24px, 4vh, 40px); display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-md); align-items: center; }
  .actions .link { margin-left: var(--space-xs); }

  /* the print: a cotton mat with a bevelled window, lit from the top left, resting on the strip */
  .print { grid-column: 8 / span 5; justify-self: end; align-self: end; width: min(100%, 460px); position: relative; z-index: 2; margin-bottom: -72px; }
  .print::after { content: ""; position: absolute; inset: auto 6% -18px 10%; height: 40px; background: radial-gradient(closest-side, oklch(20% 0.02 50 / 0.28), transparent); filter: blur(6px); z-index: -1; }
  :global(:root[data-theme="dark"]) .print::after { background: radial-gradient(closest-side, oklch(2% 0 0 / 0.7), transparent); }
  .mat { padding: clamp(16px, 2vw, 26px) clamp(16px, 2vw, 26px) clamp(12px, 1.4vw, 16px); border-radius: 2px;
    background: linear-gradient(155deg, var(--lit) 0%, var(--card) 38%, color-mix(in oklch, var(--card) 92%, var(--ink)) 100%);
    box-shadow: var(--shadow-print), inset 1px 1px 0 var(--lit); }
  .window { position: relative; overflow: hidden; aspect-ratio: 4 / 5;
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--card) 70%, var(--ink)), inset 0 0 0 1px var(--lit); }
  .window::before { /* the bevel: a cut edge of white core inside the mat */
    content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    box-shadow: inset 2px 2px 0 oklch(100% 0 0 / 0.55), inset -1px -1px 0 oklch(30% 0.02 50 / 0.18); }
  .print :global(.photo) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 24%;
    filter: saturate(0.9) contrast(1.04) sepia(0.06) brightness(1.01); transform: scale(1.001); }
  .light { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(120% 90% at 18% 8%, oklch(100% 0.01 85 / 0.18), transparent 55%), linear-gradient(to bottom, transparent 70%, oklch(20% 0.02 50 / 0.12)); mix-blend-mode: soft-light; }
  .edition { display: flex; align-items: baseline; gap: var(--space-sm); margin-top: var(--space-sm); font-size: var(--text-xs); color: var(--muted); white-space: nowrap; }
  .who { overflow: hidden; text-overflow: ellipsis; }
  .hand { flex: 0 0 2.4em; border-bottom: 1px solid var(--muted); transform: translateY(-0.25em); }
  .jp { margin-left: auto; font-family: var(--font-display); letter-spacing: 0.08em; flex-shrink: 0; }

  /* the strip: chart paper in light, a monitor field in dark */
  .strip { position: relative; height: clamp(150px, 22vh, 230px); border-block: 1px solid var(--rule);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px), linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid-minor) 1px, transparent 1px), linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 40px 40px, 40px 40px, 8px 8px, 8px 8px; background-position: -1px -1px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .strip-labels { position: absolute; inset: 0; display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: var(--space-sm); pointer-events: none; }
  .strip-labels span { color: var(--muted); background: var(--paper); padding: 2px 6px; transition: color var(--dur-long) var(--ease-out), opacity var(--dur-long) var(--ease-out); }
  .strip-labels .out { opacity: 0.55; }
  .strip[data-state="clean"] .strip-labels .in { opacity: 0.55; }
  .strip[data-state="clean"] .strip-labels .out { opacity: 1; color: var(--accent); }
  .caption { margin-block: var(--space-md) var(--space-xl); color: var(--muted); max-width: 72ch; }

  @media (max-width: 64rem) {
    .hero { min-height: 0; }
    .hero-grid { align-items: start; }
    .copy { grid-column: 1 / -1; order: 2; padding-block: var(--space-lg) var(--space-md); }
    .print { grid-column: 1 / -1; order: 1; justify-self: start; width: min(58vw, 260px); margin-bottom: 0; align-self: start; }
    .print::after { display: none; }
    .mat { padding: 10px 10px 8px; }
    .hand { display: none; }
    .edition { white-space: normal; font-size: 0.6875rem; line-height: 1.35; }
    .who { overflow: visible; }
    .strip { margin-top: var(--space-xl); height: 170px; }
  }

  /* one authored entrance: the copy settles while the print develops, from bright and soft to sharp */
  @keyframes settle { from { opacity: 0; transform: translateY(10px); } }
  @keyframes lay { from { opacity: 0; transform: translateY(18px); } }
  @keyframes develop { from { filter: saturate(0.2) contrast(0.7) brightness(1.45) blur(6px); } }
  .copy > * { animation: settle 620ms var(--ease-out) both; }
  .copy > :nth-child(2) { animation-delay: 70ms; }
  .copy > :nth-child(3) { animation-delay: 140ms; }
  .print { animation: lay 760ms var(--ease-out) 80ms both; }
  .print :global(.photo) { animation: develop 1600ms cubic-bezier(0.33, 0.1, 0.25, 1) 260ms both; }
  @media (hover: hover) and (pointer: fine) {
    .mat { transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out); }
    .print:hover .mat { transform: translateY(-3px); }
  }
</style>

<script>
  import { mountTrace } from "../scripts/trace";
  mountTrace(document.getElementById("trace") as HTMLCanvasElement, document.querySelector(".hero") as HTMLElement);
</script>
