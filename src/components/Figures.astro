---
import site from "../../content/site.json";
---
<section class="figures" aria-label="Figures">
  <div class="container">
    <dl class="readouts">
      {site.stats.map((s, i) => (
        <div class="readout" data-reveal style={`--i:${i}`}>
          <dt class="tag">{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .figures { padding-block: var(--space-xl) 0; }
  .readouts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .readout { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-xs); padding: var(--space-lg) var(--space-lg) var(--space-lg) 0; }
  .readout + .readout { border-left: 1px solid var(--rule); padding-left: var(--space-lg); }
  dd { font-family: var(--font-display); font-size: clamp(2.6rem, 4.2vw, 4.75rem); line-height: 1; color: var(--ink); letter-spacing: -0.03em; font-variant-numeric: lining-nums tabular-nums; font-variation-settings: "opsz" 72; white-space: nowrap; }
  dt { max-width: 22ch; }
  @media (max-width: 64rem) {
    .readouts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .readout:nth-child(3) { border-left: 0; padding-left: 0; }
    .readout:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }
</style>
