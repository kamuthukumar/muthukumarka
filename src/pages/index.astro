---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Figures from "../components/Figures.astro";
import News from "../components/News.astro";
import Research from "../components/Research.astro";
import Shinkai from "../components/Shinkai.astro";
import Journey from "../components/Journey.astro";
import Publications from "../components/Publications.astro";
import Honours from "../components/Honours.astro";
import Teaching from "../components/Teaching.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Beat from "../components/Beat.astro";
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Figures />
    <News />
    <Research />
    <Shinkai />
    <Journey />
    <Publications />
    <Honours />
    <div class="container"><Beat at={0.3} /></div>
    <Teaching />
    <Contact />
    <div class="container"><Beat at={0.78} /></div>
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/site";
</script>
